<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <targets>
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/EmployeeManagement.Desktop.log"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveSuffixFormat="_{1:yyyyMMdd}_{0:00}"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|thread=${threadid}|${logger}|${message}|${exception:format=Type,StackTrace}" />
  </targets>

  <rules>
    <!-- Keep application events; avoid SQL diagnostics that may contain employee values. -->
    <logger name="EmployeeManagement.*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>